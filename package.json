{
  "name": "dijon-numerique-responsable-coda",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/@slidev/cli/bin/slidev.mjs slides.md --open",
    "build": "node ./node_modules/@slidev/cli/bin/slidev.mjs build slides.md --out dist",
    "export": "node ./node_modules/@slidev/cli/bin/slidev.mjs export slides.md --output Coda-tout-en-ligne.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "latest"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "playwright-chromium": "^1.65.0"
  }
}
